# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: never expose in the browser

# --- Owner sign-in (always a super admin) -------------------------------
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=choose-a-long-unique-password

# --- Session signing --------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# --- Optional: defaults for a brand-new copy of the site ----------------
# Used until a super admin saves branding at /admin/branding.
NEXT_PUBLIC_BRAND_NAME=Sabi Consults
NEXT_PUBLIC_BRAND_TAGLINE=Helping people find their way home in Abuja
NEXT_PUBLIC_BRAND_COLOR=#0055CC

# --- Optional: Instagram feed on the homepage ---------------------------
INSTAGRAM_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=https://sabiconsults.com.ng   # used for share links
