# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: never expose in the browser

# --- Owner sign-in (always a super admin) -------------------------------
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=choose-a-long-unique-password

# --- Session signing --------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# --- Optional: defaults for a brand-new copy of the site ----------------
# Used until a super admin saves branding at /admin/branding.
NEXT_PUBLIC_BRAND_NAME=Sabi Consults
NEXT_PUBLIC_BRAND_TAGLINE=Helping people find their way home in Abuja
NEXT_PUBLIC_BRAND_COLOR=#0055CC

# --- Optional: Instagram feed on the homepage ---------------------------
INSTAGRAM_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=https://sabiconsults.com.ng   # used for share links and every link in emails

# --- Email (Resend) ----------------------------------------------------
# One provider for transactional and marketing email. Without RESEND_API_KEY
# emails are recorded and held in the queue, never reported as sent.
RESEND_API_KEY=                     # resend.com > API Keys (secret)
RESEND_WEBHOOK_SECRET=              # resend.com > Webhooks > signing secret (whsec_...)
# Optional fallbacks; the admin Email settings page overrides these
EMAIL_FROM_ADDRESS=                 # e.g. hello@sabiconsults.com.ng (domain verified in Resend)
EMAIL_REPLY_TO=
EMAIL_NOTIFY_RECIPIENTS=            # comma-separated team addresses for new-lead alerts

# --- Background worker ---------------------------------------------------
# Shared secret for /api/email/worker (Supabase pg_cron every minute, Vercel Cron daily)
CRON_SECRET=                        # openssl rand -hex 32
